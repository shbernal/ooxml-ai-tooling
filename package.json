{
  "name": "ooxml-ai-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server and agent skill giving AI agents offline, structured access to the ECMA-376 (Office Open XML) schema",
  "type": "module",
  "author": "shbernal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/ooxml-ai-tooling.git"
  },
  "homepage": "https://github.com/shbernal/ooxml-ai-tooling#readme",
  "bugs": {
    "url": "https://github.com/shbernal/ooxml-ai-tooling/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write --error-on-warnings",
    "format": "biome format --write",
    "test": "node --test --test-global-setup=build/test-setup.mjs 'core/*.test.mjs' 'mcp/*.test.mjs'",
    "check-schemas": "node build/check-schemas.mjs",
    "build:db": "node build/build-db.mjs",
    "smoke": "node mcp/smoke.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run check-schemas && pnpm run test && pnpm run smoke",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@rgrove/parse-xml": "^5.1.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
