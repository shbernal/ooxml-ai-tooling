# EditorConfig — baseline for editors and agents writing files that fall outside
# the formatter's reach. Biome owns the .mjs and .json sources named in
# biome.json; everything else — Markdown, YAML, SQL, the Makefile — relies on
# this.
#
# Duplicate, not derive: Biome does not read .editorconfig by default, so nothing
# enforces the agreement between this file and biome.json. When a formatting
# option changes in biome.json, change it here in the same commit.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Mirrors biome.json (`indentStyle: space`, `indentWidth: 2`, `lineWidth: 100`).
[*.{mjs,js,json,jsonc}]
indent_style = space
indent_size = 2
max_line_length = 100

[Makefile]
indent_style = tab

# The vendored XSDs are stored verbatim — see .gitattributes. Nothing may
# normalise them, including an editor being helpful on save.
[schemas/**]
insert_final_newline = false
trim_trailing_whitespace = false

# Markdown: keep trailing whitespace — two trailing spaces is a hard line break.
[*.md]
trim_trailing_whitespace = false
